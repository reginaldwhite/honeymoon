      "id": "waimea",
      "title": "Waimea Canyon and the Alakaʻi",
      "chip": "Waimea Canyon",
      "note": "Back into the tent, three thousand feet up. Swamp boardwalk one day, a cliff trail over the sea the next.",
      "start": "2009-06-04",
      "end": "2009-06-06",
