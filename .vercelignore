# The Vercel CLI does NOT read .gitignore; without this file it would upload
# the whole photo library. Keep this in step with .gitignore, with one
# deliberate difference: public/media (generated by `npm run build-media`,
# ignored by git) IS uploaded, because the deployed site serves photos from it.
node_modules
.next
.vercel
.env*
!.env.example
/media
/media-source
/coverage
/out
/build
*.tsbuildinfo
.DS_Store
*.pem
npm-debug.log*
.claude
