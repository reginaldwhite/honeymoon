# Copy this file to .env.local and fill in real values.
# Generate SITE_PASSWORD_HASH + SESSION_SECRET with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: escape every $ in the bcrypt hash as \$ (e.g. \$2b\$12\$...),
# otherwise Next.js's env-file variable expansion will silently blank it out.

SITE_PASSWORD_HASH=""
SESSION_SECRET=

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local admin media browser (dev-only) — path to your local copy of the photo library
PHOTO_SOURCE_DIR=media
